# ============================================================
# AI E-COMMERCE & RECOMMENDATION PLATFORM - ENVIRONMENT CONFIG
# ============================================================

# Environment: development, staging, production
ENVIRONMENT=development
DEBUG=True
APP_NAME="AI E-Commerce & Recommendation Platform"
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-with-a-secure-32-byte-hex-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (PostgreSQL in production, SQLite fallback in standalone development)
DATABASE_URL=sqlite:///./ecommerce.db
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ecommerce_db
DB_ECHO=False
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis Configuration (Cache, Rate Limiting, Celery Broker)
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=False

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Elasticsearch Configuration
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_ENABLED=False
ELASTICSEARCH_INDEX_PREFIX=ecommerce_

# MinIO / Object Storage Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=ecommerce-assets
MINIO_SECURE=False
LOCAL_STORAGE_DIR=./storage

# AI & Machine Learning Configuration
MODEL_REGISTRY_DIR=./ai/model_registry/artifacts
EMBEDDING_DIMENSION=64
DEFAULT_RECOMMENDATION_COUNT=10
ANOMALY_DETECTION_THRESHOLD=0.65
CHURN_THRESHOLD_DAYS=60

# CORS & Security
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
RATE_LIMIT_PER_MINUTE=120

# Real-time WebSocket Configuration
WS_HEARTBEAT_INTERVAL=30

# Monitoring & Logging
LOG_LEVEL=INFO
PROMETHEUS_METRICS_ENABLED=True
